# Path to the secret key of the account that will be used to deploy the contracts.
ODRA_CASPER_LIVENET_SECRET_KEY_PATH=

# RPC address of the node that will be used to deploy the contracts.
# ODRA_CASPER_LIVENET_NODE_ADDRESS=http://localhost:11101
ODRA_CASPER_LIVENET_NODE_ADDRESS=http://142.44.137.71:7777
# ODRA_CASPER_LIVENET_NODE_ADDRESS=https://node.cspr.cloud
# Chain name of the network.
# ODRA_CASPER_LIVENET_CHAIN_NAME=casper-test
ODRA_CASPER_LIVENET_CHAIN_NAME=casper

ODRA_CASPER_LIVENET_EVENTS_URL=http://152.53.144.92:9999/events
CSPR_CLOUD_AUTH_TOKEN=

BOT_DELTA_TRADE_SIZE_USD=1
BOT_STCSPR_TRADE_SIZE_USD=15

BOT_MIN_BALANCE_WCSPR=10000000000000 # 10k CSPR
BOT_MAX_BALANCE_WCSPR=30000000000000 # 30k CSPR
BOT_MIN_BALANCE_CSPR=10000000000000 # 10k CSPR
BOT_MAX_BALANCE_CSPR=30000000000000 # 30k CSPR
BOT_MIN_BALANCE_STCSRP=10000000000000 # 10k stCSPR
BOT_MAX_BALANCE_STCSPR=30000000000000 # 30k stCSPR
BOT_MIN_BALANCE_LONG=1000000000000 # 1000 LONG
BOT_MAX_BALANCE_LONG=4000000000000 # 4000 LONG
BOT_MIN_BALANCE_SHORT=80000000000 # 80 SHORT
BOT_MAX_BALANCE_SHORT=300000000000 # 300 SHORT